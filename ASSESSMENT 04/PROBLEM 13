// write a program to get a number from user and interchange the first and last digits and print the result
#include <stdio.h>
int main()
{
    int n, pow = 1, a, c, d;
    scanf("%d", &n);
    c = n;

start:
    if (c > 9)
    {
        c /= 10;
        pow *= 10;
        goto start;
    }
    a = n % 10;
    d = (n % pow) / 10;
    printf("%d", a * pow + d * 10 + c);
    return 0;
}
